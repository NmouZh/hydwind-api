# hydwind-api 运行配置示例。不要把真实密钥提交进仓库。

HOST=127.0.0.1
PORT=8787

# 网站对外地址；用于同源校验与 Secure Cookie 判断
PUBLIC_ORIGIN=http://localhost:4324

# 只信任这些直连对端转发来的 X-Forwarded-* 头
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# 与 hydwind-web / hydwind-gate 共用；切换时必须保持一致
SESSION_SECRET=change-me-please-change-me
ISSUE_ADMIN_TOKEN=change-me-admin-token
PLUGIN_TOKEN=change-me-plugin-token
# 仅用于 PUT /api/launcher/admin/client-pack；未配置时管理接口返回 401
LAUNCHER_ADMIN_TOKEN=change-me-launcher-admin-token

# 现有 JSON 数据目录与新的 SQLite 文件位置
HYDWIND_DATA_DIR=./data

# hydwind-web 的内容目录：site/info.md 与 people/*.md
HYDWIND_CONTENT_DIR=../hydwind-web/src/content

# official | bmclapi；NeoForge 官方 maven 在当前网络不可达，可用 bmclapi
HYDWIND_MIRROR=official

# Modrinth 要求可识别的 User-Agent
MODRINTH_USER_AGENT=hydwind-launcher/0.1.0 (https://github.com/NmouZh/hydwind_launcher)

# 可选：覆盖服务器状态上游
# STATUS_ENDPOINT=https://api.mcstatus.io/v2/status/java